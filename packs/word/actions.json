[
  {
    "id": "word_formula",
    "label": "插入公式",
    "description": "插入公式 (Alt+=)",
    "steps": [
      { "type": "hotkey", "hotkey": "ALT+=", "keys": ["ALT", "="] }
    ],
    "auto_enter": false,
    "on_error": "stop"
  },
  {
    "id": "word_date_time",
    "label": "插入日期与时间",
    "description": "插入日期与时间 (Alt+Shift+D + Alt+Shift+T)",
    "steps": [
      { "type": "hotkey", "hotkey": "ALT+SHIFT+D", "keys": ["ALT", "SHIFT", "D"] },
      { "type": "delay", "ms": 50 },
      { "type": "key", "key": "SPACE" },
      { "type": "delay", "ms": 50 },
      { "type": "hotkey", "hotkey": "ALT+SHIFT+T", "keys": ["ALT", "SHIFT", "T"] }
    ],
    "auto_enter": false,
    "on_error": "stop"
  },
  {
    "id": "word_line_spacing",
    "label": "设置行距",
    "description": "段落与行距设置 (Alt->H->P->G->Alt+N->Alt+A)",
    "steps": [
      { "type": "key", "key": "ALT" },
      { "type": "delay", "ms": 80 },
      { "type": "key", "key": "H" },
      { "type": "delay", "ms": 80 },
      { "type": "key", "key": "P" },
      { "type": "delay", "ms": 80 },
      { "type": "key", "key": "G" },
      { "type": "delay", "ms": 150 },
      { "type": "hotkey", "hotkey": "ALT+N", "keys": ["ALT", "N"] },
      { "type": "delay", "ms": 80 },
      { "type": "hotkey", "hotkey": "ALT+A", "keys": ["ALT", "A"] }
    ],
    "auto_enter": false,
    "on_error": "stop"
  },
  {
    "id": "word_fangsong_gb2312",
    "label": "仿宋_GB2312",
    "description": "公文标准字体仿宋_GB2312",
    "steps": [
      { "type": "hotkey", "hotkey": "CTRL+D", "keys": ["CTRL", "D"] },
      { "type": "delay", "ms": 200 },
      { "type": "paste", "value": "仿宋_GB2312" },
      { "type": "delay", "ms": 100 },
      { "type": "key", "key": "ENTER" }
    ],
    "auto_enter": false,
    "on_error": "stop"
  },
  {
